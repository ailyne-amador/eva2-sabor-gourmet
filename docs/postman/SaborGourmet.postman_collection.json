        },
        {
          "name": "Crear reserva de prueba",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"clienteId\": 1,\n  \"mesaId\": 1,\n  \"fecha\": \"{{fechaDisponibilidad}}\",\n  \"hora\": \"19:00\",\n  \"cantidadPersonas\": 2\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/reservas" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201 y Location', function () {", "    pm.response.to.have.status(201);", "    pm.expect(pm.response.headers.get('Location')).to.include('/api/reservas/');", "});", "pm.collectionVariables.set('reservaPruebaId', pm.response.json().id.toString());"] } }]
