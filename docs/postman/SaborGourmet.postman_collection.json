          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200 y estado CANCELADA', function () {", "    pm.response.to.have.status(200);", "    pm.expect(pm.response.json().estado).to.eql('CANCELADA');", "});"] } }]
        },
        {
          "name": "Disponibilidad después de cancelar",
