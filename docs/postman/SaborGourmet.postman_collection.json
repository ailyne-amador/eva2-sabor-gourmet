          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200 y mesa 1 disponible', function () {", "    pm.response.to.have.status(200);", "    pm.expect(pm.response.json().some(function (mesa) { return mesa.id === 1; })).to.eql(true);", "});"] } }]
        },
