          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201 y Location', function () {", "    pm.response.to.have.status(201);", "    pm.expect(pm.response.headers.get('Location')).to.include('/api/mesas/');", "});", "pm.collectionVariables.set('mesaPruebaId', pm.response.json().id.toString());"] } }]
        },
        {
          "name": "Modificar mesa creada",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"numero\": 4,\n  \"capacidad\": 3,\n  \"ubicacion\": \"Salón de pruebas\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/mesas/{{mesaPruebaId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Eliminar mesa creada",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/mesas/{{mesaPruebaId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"] } }]
        }
      ]
    },
    {
      "name": "03 Disponibilidad",
      "item": [
        {
          "name": "Turno libre antes de reservar",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/mesas/disponibles?fecha={{fechaDisponibilidad}}&hora=19:00&personas=2" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200 y mesa 1 disponible', function () {", "    pm.response.to.have.status(200);", "    pm.expect(pm.response.json().some(function (mesa) { return mesa.id === 1; })).to.eql(true);", "});"] } }]
        },
        {
          "name": "Reserva de ejemplo bloquea mesa 2",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/mesas/disponibles?fecha=2026-12-05&hora=20:00&personas=4" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200 y mesa 2 no disponible', function () {", "    pm.response.to.have.status(200);", "    pm.expect(pm.response.json().some(function (mesa) { return mesa.id === 2; })).to.eql(false);", "});"] } }]
        }
      ]
    },
    {
