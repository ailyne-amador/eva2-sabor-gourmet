          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200 y fecha modificada', function () {", "    pm.response.to.have.status(200);", "    pm.expect(pm.response.json().fecha).to.eql(pm.collectionVariables.get('fechaReservaModificada'));", "});"] } }]
        },
        {
          "name": "Consultar reserva modificada",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/reservas/{{reservaPruebaId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200 y fecha modificada', function () {", "    pm.response.to.have.status(200);", "    pm.expect(pm.response.json().fecha).to.eql(pm.collectionVariables.get('fechaReservaModificada'));", "});"] } }]
