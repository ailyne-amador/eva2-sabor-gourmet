{
  "info": {
    "name": "Sabor Gourmet — Reservas",
    "description": "Recorrido HTTP ordenado. Inicia la aplicación con data/datos.json de ejemplo y ejecuta la colección completa para que las variables de IDs se capturen al crear recursos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "clienteIdBase", "value": "1" },
    { "key": "mesaIdBase", "value": "1" },
    { "key": "mesaIdReservada", "value": "2" },
    { "key": "reservaIdBase", "value": "1" },
    { "key": "fechaDisponibilidad", "value": "2026-12-07" },
    { "key": "fechaReservaModificada", "value": "2026-12-08" }
  ],
  "item": [
    {
      "name": "01 Clientes",
      "item": [
        {
          "name": "Listar clientes",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/clientes" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Consultar cliente existente",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/clientes/{{clienteIdBase}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Crear cliente",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Paula Postman\",\n  \"email\": \"paula.postman@example.com\",\n  \"telefono\": \"+56911112222\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/clientes" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201 y Location', function () {", "    pm.response.to.have.status(201);", "    pm.expect(pm.response.headers.get('Location')).to.include('/api/clientes/');", "});", "pm.collectionVariables.set('clientePruebaId', pm.response.json().id.toString());"] } }]
        },
        {
          "name": "Modificar cliente creado",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Paula Postman Actualizada\",\n  \"email\": \"paula.actualizada@example.com\",\n  \"telefono\": \"+56911112222\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/clientes/{{clientePruebaId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Eliminar cliente creado",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/clientes/{{clientePruebaId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"] } }]
        }
      ]
    },
    {
      "name": "02 Mesas",
      "item": [
        {
          "name": "Listar mesas",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/mesas" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Consultar mesa existente",
